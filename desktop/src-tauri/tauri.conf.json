{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mosh",
  "version": "0.2.0-preview.1",
  "identifier": "com.connorbache.mosh",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Mosh", "width": 1300, "height": 860, "minWidth": 800, "minHeight": 540 }],
    "security": { "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost" }
  },
  "bundle": { "active": true, "targets": ["nsis"], "icon": ["icons/icon.ico"] }
}
